---
layout: bas.njk
permalink: /kontakt/index.html
sida: kontakt
sokvag: /kontakt/
---
{%- set s = sidor['kontakt'] -%}
<main id="innehall">
{% include "kort.njk" %}

<section aria-labelledby="h1" class="phero" style="padding-bottom:48px">
  <div class="wrap g phero-grid" style="align-items:end">
    <div class="phero-txt">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{{ s.topp.overrubrik | mdi | safe }}</p>
      <h1 id="h1">{{ s.topp.rubrik | mdi | safe }}</h1>
      <p class="lead">{{ s.topp.ingress | mdi | safe }}</p>
    </div>
    <div class="card info-box">
      <p>{{ s.topp.stycke | mdi | safe }}</p>
      <a class="btn btn-cta" href="/boka/">Boka tolk</a>
    </div>
  </div>
</section>

<section aria-labelledby="h-skriv" class="sec" style="padding-top:0">
  <div class="wrap g side-grid">
    <div class="mailflow">
      <div class="stack" style="gap:12px">
        <h2 id="h-skriv">{{ s.h_skriv.rubrik | mdi | safe }}</h2>
        <p class="muted">{{ s.h_skriv.stycke | mdi | safe }}</p>
      </div>

      <div class="notice" role="note">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"></path><path d="M9 12l2 2 4-4"></path></svg>
        <p>{{ s.h_skriv.stycke2 | mdi | safe }}</p>
      </div>

      <div class="mall">
        <h3 id="h-mall">{{ s.h_skriv.underrubrik | mdi | safe }}</h3>
<pre id="mall-kontakt" tabindex="0" role="region" aria-labelledby="h-mall">{{ s.h_skriv.mall | tok }}</pre>
        <div class="mall-actions">
          <a class="btn btn-pet btn-lg" href="mailto:{{ k.epost }}?subject=Fr%C3%A5ga%20till%20Linkaro" data-mail-body="#mall-kontakt">Skriv e-post till oss</a>
          <button type="button" class="btn btn-sec btn-lg" data-copy="#mall-kontakt" data-status="copy-kontakt">Kopiera mallen</button>
        </div>
        <p id="copy-kontakt" class="copy-status" role="status"></p>
      </div>
      <p class="muted">{{ s.h_skriv.stycke3 | mdi | safe }}</p>
    </div>

    <div class="info">
      <div class="card info-box">
        <h2 id="h-andra">{{ s.h_skriv.rubrik2 | mdi | safe }}</h2>
        <div class="ways">
          <div><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="M3 7l9 6 9-6"></path></svg><div><h3>{{ s.h_skriv.underrubrik2 | mdi | safe }}</h3><p>{{ s.h_skriv.stycke4 | mdi | safe }}</p><p class="small">{{ s.h_skriv.stycke5 | mdi | safe }}</p></div></div>
          <div><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h16v11H9l-5 4z"></path><path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01"></path></svg><div><h3>{{ s.h_skriv.underrubrik3 | mdi | safe }}</h3><p>{{ k.smsLank | safe }}</p><p class="small">{{ s.h_skriv.stycke6 | mdi | safe }}</p></div></div>
          <div id="video"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="6" width="13" height="12" rx="1.5"></rect><path d="M16 10l5-3v10l-5-3"></path></svg><div><h3>{{ s.h_skriv.underrubrik4 | mdi | safe }}</h3><p class="small">{{ s.h_skriv.stycke7 | mdi | safe }}</p>
            <!-- Byt mot länken till bokningssidan (till exempel Microsoft Bookings) när den finns:
            <p><a href="https://…">Välj en tid <span aria-hidden="true">→</span></a></p> -->
            <p>{{ s.h_skriv.stycke8 | mdi | safe }}</p></div></div>
        </div>
      </div>
      <div class="card info-box">
        <h2 id="h-finns">{{ s.h_skriv.rubrik3 | mdi | safe }}</h2>
        <p class="small muted">{{ s.h_skriv.stycke9 | mdi | safe }}</p>
        <dl class="facts facts-sm">
          <div><dt>{{ s.h_skriv.begrepp | mdi | safe }}</dt><dd>{{ s.h_skriv.forklaring | mdi | safe }}</dd></div>
          <div><dt>{{ s.h_skriv.begrepp2 | mdi | safe }}</dt><dd>{{ k.orgnr }}</dd></div>
          <div><dt>{{ s.h_skriv.begrepp3 | mdi | safe }}</dt><dd>{{ k.sate }}</dd></div>
        </dl>
      </div>
    </div>
  </div>
</section>
</main>
