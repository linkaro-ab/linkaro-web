---
layout: bas.njk
permalink: /index.html
sida: hem
sokvag: /
---
{%- set s = sidor['hem'] -%}
<main id="innehall">

<!-- ===== Enkelt läge: lättläst version av startsidan ===== -->
<div class="simple-only" hidden>
  {% include "kort.njk" %}

  <section class="wrap" aria-labelledby="s-h1">
    <h1 id="s-h1">{{ s.enkelt.s_h1.rubrik | mdi | safe }}</h1>
    <p>{{ s.enkelt.s_h1.stycke | mdi | safe }}</p>
    <div class="btns" style="margin-top:24px">
      <a class="btn btn-cta" href="/boka/">Boka tolk</a>
      <a class="btn btn-sec" href="/kontakt/">Kontakta oss</a>
    </div>
  </section>

  <section class="wrap" aria-labelledby="s-video">
    <h2 id="s-video">{{ s.enkelt.s_video.rubrik | mdi | safe }}</h2>
    <p>{{ s.enkelt.s_video.stycke | mdi | safe }}</p>
    <p>{{ s.enkelt.s_video.stycke2 | mdi | safe }}</p>
  </section>

  <section class="wrap" aria-labelledby="s-tj">
    <h2 id="s-tj">{{ s.enkelt.s_tj.rubrik | mdi | safe }}</h2>
    <ul class="bullets">
      <li>{{ s.enkelt.s_tj.punkt | mdi | safe }}</li>
      <li>{{ s.enkelt.s_tj.punkt2 | mdi | safe }}</li>
      <li>{{ s.enkelt.s_tj.punkt3 | mdi | safe }}</li>
    </ul>
    <p>{{ s.enkelt.s_tj.stycke | mdi | safe }}</p>
  </section>

  <section class="wrap" aria-labelledby="s-var">
    <h2 id="s-var">{{ s.enkelt.s_var.rubrik | mdi | safe }}</h2>
    <ul class="bullets">
      <li>{{ s.enkelt.s_var.punkt | mdi | safe }}</li>
      <li>{{ s.enkelt.s_var.punkt2 | mdi | safe }}</li>
      <li>{{ s.enkelt.s_var.punkt3 | mdi | safe }}</li>
      <li>{{ s.enkelt.s_var.punkt4 | mdi | safe }}</li>
      <li>{{ s.enkelt.s_var.punkt5 | mdi | safe }}</li>
      <li>{{ s.enkelt.s_var.punkt6 | mdi | safe }}</li>
    </ul>
  </section>

  <section class="wrap" aria-labelledby="s-lita">
    <h2 id="s-lita">{{ s.enkelt.s_lita.rubrik | mdi | safe }}</h2>
    <ul class="bullets">
      <li>{{ s.enkelt.s_lita.punkt | mdi | safe }}</li>
      <li>{{ s.enkelt.s_lita.punkt2 | mdi | safe }}</li>
      <li>{{ s.enkelt.s_lita.punkt3 | mdi | safe }}</li>
      <li>{{ s.enkelt.s_lita.punkt4 | mdi | safe }}</li>
    </ul>
  </section>

  <section class="wrap" aria-labelledby="s-kontakt">
    <h2 id="s-kontakt">{{ s.enkelt.s_kontakt.rubrik | mdi | safe }}</h2>
    <p>{{ s.enkelt.s_kontakt.stycke | mdi | safe }}</p>
    <ul class="bullets">
      <li>{{ s.enkelt.s_kontakt.punkt | mdi | safe }}</li>
      <li>{{ s.enkelt.s_kontakt.punkt2 | mdi | safe }}</li>
      <li>{{ s.enkelt.s_kontakt.punkt3 | mdi | safe }}</li>
    </ul>
    <div class="btns" style="margin-top:16px"><a class="btn btn-cta" href="/boka/">Boka tolk</a></div>
  </section>

  <section class="wrap" aria-labelledby="s-tolk">
    <h2 id="s-tolk">{{ s.enkelt.s_tolk.rubrik | mdi | safe }}</h2>
    <p>{{ s.enkelt.s_tolk.stycke | mdi | safe }}</p>
  </section>
</div>

<!-- ===== Normalt läge ===== -->
<div class="normal-only">

<section aria-labelledby="h-hero" class="hero">
  <div class="wrap g hero-grid">
    <div class="hero-txt">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span><span><span class="only-d">Tolkning i </span>Stockholmsregionen och <span class="only-d">på </span>distans</span></p>
      <h1 id="h-hero">{{ s.h_hero.rubrik | mdi | safe }}</h1>
      <p class="hero-lead">{{ s.h_hero.ingress | mdi | safe }}</p>
      <div class="btns">
        <a class="btn btn-cta btn-lg" href="/boka/">Boka tolk</a>
        <a class="btn btn-sec btn-lg" href="/kontakt/">Kontakta oss</a>
      </div>
      <ul class="hero-checks">
        <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>{{ s.h_hero.punkt | mdi | safe }}</li>
      </ul>
    </div>
    <div class="hero-art">
      {% bild s.h_hero.bild, s.h_hero.bildtext, "hero-photo hero-img", "(max-width: 699px) 300px, (max-width: 1023px) 380px, 470px", [480, 940], true %}
      <div class="hero-orbit drift" aria-hidden="true">
        <svg class="hero-ring" viewBox="0 0 380 380" focusable="false"><circle cx="190" cy="190" r="188" fill="none" stroke="#2BA89A" stroke-width="3"></circle></svg>
        <span class="orbit-arm"><span class="hero-core"></span></span>
      </div>
    </div>
  </div>
</section>

<section aria-labelledby="h-trust" class="trust">
  <h2 id="h-trust" class="vh">{{ s.h_trust.rubrik | mdi | safe }}</h2>
  <ul class="wrap g g-4 trust-grid">
    <li><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 9l10-5 10 5-10 5z"></path><path d="M6 11v5c3 2 9 2 12 0v-5"></path></svg><div><p class="trust-t">{{ s.h_trust.del1.rubrik | mdi | safe }}</p><p class="trust-d">{{ s.h_trust.del1.text | mdi | safe }}</p></div></li>
    <li><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v16M6 20h12M5 7h14"></path><path d="M5 7l-3 6a3 3 0 0 0 6 0z"></path><path d="M19 7l-3 6a3 3 0 0 0 6 0z"></path></svg><div><p class="trust-t">{{ s.h_trust.del2.rubrik | mdi | safe }}</p><p class="trust-d">{{ s.h_trust.del2.text | mdi | safe }}</p></div></li>
    <li><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="11" width="14" height="9" rx="1.5"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg><div><p class="trust-t">{{ s.h_trust.del3.rubrik | mdi | safe }}</p><p class="trust-d">{{ s.h_trust.del3.text | mdi | safe }}</p></div></li>
    <li><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 12a8 8 0 0 1-14 5.3"></path><path d="M4 12a8 8 0 0 1 14-5.3"></path><path d="M18 3v4h-4"></path><path d="M6 21v-4h4"></path></svg><div><p class="trust-t">{{ s.h_trust.del4.rubrik | mdi | safe }}</p><p class="trust-d">{{ s.h_trust.del4.text | mdi | safe }}</p></div></li>
  </ul>
</section>

<section aria-labelledby="h-tj" class="sec">
  <div class="wrap stack-48">
    <div class="sec-head">
      <div class="sec-intro">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{{ s.h_tj.overrubrik | mdi | safe }}</p>
        <h2 id="h-tj">{{ s.h_tj.rubrik | mdi | safe }}</h2>
        <p class="lead">{{ s.h_tj.ingress | mdi | safe }}</p>
      </div>
      <a href="/tjanster/" class="link-strong">Alla tjänster <span aria-hidden="true">→</span></a>
    </div>
    <div class="g g-auto">
      <article class="card svc">
        <svg width="72" height="56" viewBox="0 0 72 56" aria-hidden="true" focusable="false"><circle cx="27" cy="28" r="25" fill="none" stroke="#2BA89A" stroke-width="1.5"></circle><circle cx="45" cy="28" r="25" fill="none" stroke="#2BA89A" stroke-width="1.5" opacity=".5"></circle><svg x="25" y="17" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13V6.5a1.5 1.5 0 0 1 3 0V12"></path><path d="M11 11V5a1.5 1.5 0 0 1 3 0v6"></path><path d="M14 11V6.5a1.5 1.5 0 0 1 3 0V14a6 6 0 0 1-6 6h-.5a6 6 0 0 1-5-2.7L3.8 14.5a1.5 1.5 0 0 1 2.4-1.8L8 15"></path></svg></svg>
        <h3>{{ s.h_tj.kort1.rubrik | mdi | safe }}</h3>
        <p>{{ s.h_tj.kort1.text | mdi | safe }}</p>
        <a href="/tjanster/#teckensprak" class="link-strong svc-more">Läs mer<span class="vh"> om teckenspråkstolkning</span> <span aria-hidden="true">→</span></a>
      </article>
      <article class="card svc">
        <svg width="72" height="56" viewBox="0 0 72 56" aria-hidden="true" focusable="false"><circle cx="27" cy="28" r="25" fill="none" stroke="#2BA89A" stroke-width="1.5"></circle><circle cx="45" cy="28" r="25" fill="none" stroke="#2BA89A" stroke-width="1.5" opacity=".5"></circle><svg x="25" y="17" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14l4-4 3 2 3-3"></path><path d="M10 20l3-3 3 1 5-5"></path><circle cx="18" cy="5" r="1.2"></circle><circle cx="6" cy="19" r="1.2"></circle></svg></svg>
        <h3>{{ s.h_tj.kort2.rubrik | mdi | safe }}</h3>
        <p>{{ s.h_tj.kort2.text | mdi | safe }}</p>
        <a href="/tjanster/#dovblind" class="link-strong svc-more">Läs mer<span class="vh"> om dövblindtolkning</span> <span aria-hidden="true">→</span></a>
      </article>
      <article class="card svc">
        <svg width="72" height="56" viewBox="0 0 72 56" aria-hidden="true" focusable="false"><circle cx="27" cy="28" r="25" fill="none" stroke="#2BA89A" stroke-width="1.5"></circle><circle cx="45" cy="28" r="25" fill="none" stroke="#2BA89A" stroke-width="1.5" opacity=".5"></circle><svg x="25" y="17" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="1.5"></rect><path d="M8 20h8M12 16v4"></path><circle cx="12" cy="9" r="2"></circle><path d="M8.5 14a3.5 3.5 0 0 1 7 0"></path></svg></svg>
        <h3>{{ s.h_tj.kort3.rubrik | mdi | safe }}</h3>
        <p>{{ s.h_tj.kort3.text | mdi | safe }}</p>
        <a href="/tjanster/#distans" class="link-strong svc-more">Läs mer<span class="vh"> om distanstolkning</span> <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </div>
</section>

<section aria-labelledby="h-var" class="sec dark deco">
  <svg class="deco-svg deco-a link" width="760" height="520" viewBox="0 0 760 520" aria-hidden="true" focusable="false"><circle class="rl" cx="260" cy="260" r="250" fill="none" stroke="#7FD1C7" stroke-width="2" opacity=".45"></circle><circle class="rr" cx="500" cy="260" r="250" fill="none" stroke="#7FD1C7" stroke-width="2" opacity=".45"></circle></svg>
  <div class="wrap stack-48">
    <div class="sec-intro">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{{ s.h_var.overrubrik | mdi | safe }}</p>
      <h2 id="h-var">{{ s.h_var.rubrik | mdi | safe }}</h2>
      <p class="lead">{{ s.h_var.ingress | mdi | safe }}</p>
    </div>
    <ul class="g g-3 place-grid">
      <li class="place"><svg width="72" height="56" viewBox="0 0 72 56" aria-hidden="true" focusable="false"><circle cx="27" cy="28" r="25" fill="none" stroke="#7FD1C7" stroke-width="1.5"></circle><circle cx="45" cy="28" r="25" fill="none" stroke="#7FD1C7" stroke-width="1.5" opacity=".45"></circle><svg x="25" y="17" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path><path d="M7.5 11h2.5l1.5-2 2 4 1.5-2h1.5"></path></svg></svg><div><h3>{{ s.h_var.del1.rubrik | mdi | safe }}</h3><p>{{ s.h_var.del1.text | mdi | safe }}</p></div></li>
      <li class="place"><svg width="72" height="56" viewBox="0 0 72 56" aria-hidden="true" focusable="false"><circle cx="27" cy="28" r="25" fill="none" stroke="#7FD1C7" stroke-width="1.5"></circle><circle cx="45" cy="28" r="25" fill="none" stroke="#7FD1C7" stroke-width="1.5" opacity=".45"></circle><svg x="25" y="17" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 13h18"></path></svg></svg><div><h3>{{ s.h_var.del2.rubrik | mdi | safe }}</h3><p>{{ s.h_var.del2.text | mdi | safe }}</p></div></li>
      <li class="place"><svg width="72" height="56" viewBox="0 0 72 56" aria-hidden="true" focusable="false"><circle cx="27" cy="28" r="25" fill="none" stroke="#7FD1C7" stroke-width="1.5"></circle><circle cx="45" cy="28" r="25" fill="none" stroke="#7FD1C7" stroke-width="1.5" opacity=".45"></circle><svg x="25" y="17" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h6a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H3z"></path><path d="M21 5h-6a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h7z"></path></svg></svg><div><h3>{{ s.h_var.del3.rubrik | mdi | safe }}</h3><p>{{ s.h_var.del3.text | mdi | safe }}</p></div></li>
      <li class="place"><svg width="72" height="56" viewBox="0 0 72 56" aria-hidden="true" focusable="false"><circle cx="27" cy="28" r="25" fill="none" stroke="#7FD1C7" stroke-width="1.5"></circle><circle cx="45" cy="28" r="25" fill="none" stroke="#7FD1C7" stroke-width="1.5" opacity=".45"></circle><svg x="25" y="17" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"></circle><circle cx="17" cy="9" r="2.5"></circle><path d="M3 20a6 6 0 0 1 12 0"></path><path d="M15.5 20a4.5 4.5 0 0 1 5.5-4.4"></path></svg></svg><div><h3>{{ s.h_var.del4.rubrik | mdi | safe }}</h3><p>{{ s.h_var.del4.text | mdi | safe }}</p></div></li>
      <li class="place"><svg width="72" height="56" viewBox="0 0 72 56" aria-hidden="true" focusable="false"><circle cx="27" cy="28" r="25" fill="none" stroke="#7FD1C7" stroke-width="1.5"></circle><circle cx="45" cy="28" r="25" fill="none" stroke="#7FD1C7" stroke-width="1.5" opacity=".45"></circle><svg x="25" y="17" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10l9-6 9 6"></path><path d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18"></path></svg></svg><div><h3>{{ s.h_var.del5.rubrik | mdi | safe }}</h3><p>{{ s.h_var.del5.text | mdi | safe }}</p></div></li>
      <li class="place"><svg width="72" height="56" viewBox="0 0 72 56" aria-hidden="true" focusable="false"><circle cx="27" cy="28" r="25" fill="none" stroke="#7FD1C7" stroke-width="1.5"></circle><circle cx="45" cy="28" r="25" fill="none" stroke="#7FD1C7" stroke-width="1.5" opacity=".45"></circle><svg x="25" y="17" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4l-5.3 3 1.2-6-4.5-4.1 6-.7z"></path></svg></svg><div><h3>{{ s.h_var.del6.rubrik | mdi | safe }}</h3><p>{{ s.h_var.del6.text | mdi | safe }}</p></div></li>
    </ul>
  </div>
</section>

<section aria-labelledby="h-why" class="sec">
  <div class="wrap g why-grid">
    <div class="sec-intro">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{{ s.h_why.overrubrik | mdi | safe }}</p>
        <h2 id="h-why">{{ s.h_why.rubrik | mdi | safe }}</h2>
      </div>
    <ol class="num-list">
        <li><span class="num" aria-hidden="true">01</span><div><h3>{{ s.h_why.steg1.rubrik | mdi | safe }}</h3><p>{{ s.h_why.steg1.text | mdi | safe }}</p></div></li>
        <li><span class="num" aria-hidden="true">02</span><div><h3>{{ s.h_why.steg2.rubrik | mdi | safe }}</h3><p>{{ s.h_why.steg2.text | mdi | safe }}</p></div></li>
        <li><span class="num" aria-hidden="true">03</span><div><h3>{{ s.h_why.steg3.rubrik | mdi | safe }}</h3><p>{{ s.h_why.steg3.text | mdi | safe }}</p></div></li>
      </ol>
  </div>
</section>

</div><!-- /normal-only -->

<!-- Videon visas i båda lägena. -->
<section id="video" aria-labelledby="h-video" class="sec sec-panel">
  <div class="wrap g video-grid">
    <div class="video-txt">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{{ s.h_video.overrubrik | mdi | safe }}</p>
      <h2 id="h-video">{{ s.h_video.rubrik | mdi | safe }}</h2>
      <p class="lead">{{ s.h_video.ingress | mdi | safe }}</p>
    </div>
    <figure class="video-fig">
      <div class="player">
        <!-- När filmen finns: ta bort .player-ph och använd
        <video controls preload="metadata" playsinline poster="/assets/video/valkommen-poster.jpg">
          <source src="/assets/video/valkommen.mp4" type="video/mp4">
          <track kind="captions" src="/assets/video/valkommen.sv.vtt" srclang="sv" label="Svenska" default>
          Din webbläsare kan inte visa filmen. Läs filmens text nedan.
        </video>
        Filmen startar aldrig av sig själv. Textningen ligger i valkommen.sv.vtt. -->
        <div class="player-ph">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#C9DADD" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="6" width="13" height="12" rx="1.5"></rect><path d="M16 10l5-3v10l-5-3"></path></svg>
          <p>{{ s.h_video.stycke | mdi | safe }}</p>
        </div>
      </div>
      <figcaption>
        <details class="transcript">
          <summary>{{ s.h_video.fraga | mdi | safe }}</summary>
          <div class="transcript-body">
            <p>{{ s.h_video.stycke2 | mdi | safe }}</p>
            <p>{{ s.h_video.stycke3 | mdi | safe }}</p>
          </div>
        </details>
      </figcaption>
    </figure>
  </div>
</section>

<div class="normal-only">

<section aria-labelledby="h-tolk" class="sec dark deco">
  <svg class="deco-svg deco-b link" width="640" height="440" viewBox="0 0 640 440" aria-hidden="true" focusable="false"><circle class="rl" cx="220" cy="220" r="210" fill="none" stroke="#7FD1C7" stroke-width="2" opacity=".45"></circle><circle class="rr" cx="420" cy="220" r="210" fill="none" stroke="#7FD1C7" stroke-width="2" opacity=".45"></circle></svg>
  <div class="wrap g tolk-grid">
    <div class="stack" style="gap:20px">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{{ s.h_tolk.overrubrik | mdi | safe }}</p>
      <h2 id="h-tolk">{{ s.h_tolk.rubrik | mdi | safe }}</h2>
      <p class="lead">{{ s.h_tolk.ingress | mdi | safe }}</p>
      <a class="btn btn-sec" href="/bli-tolk/">Bli tolk hos oss</a>
    </div>
    <ul class="checks tolk-list">
      <li><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7FD1C7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>{{ s.h_tolk.punkt | mdi | safe }}</li>
      <li><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7FD1C7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>{{ s.h_tolk.punkt2 | mdi | safe }}</li>
      <li><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7FD1C7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>{{ s.h_tolk.punkt3 | mdi | safe }}</li>
    </ul>
  </div>
</section>

<section aria-labelledby="h-kontakt" class="sec">
  <div class="wrap stack-48">
    <div class="sec-intro">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{{ s.h_kontakt.overrubrik | mdi | safe }}</p>
      <h2 id="h-kontakt">{{ s.h_kontakt.rubrik | mdi | safe }}</h2>
      <p class="lead">{{ s.h_kontakt.ingress | mdi | safe }}</p>
    </div>
    <ul class="g g-4 plain">
