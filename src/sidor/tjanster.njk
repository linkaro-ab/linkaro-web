---
layout: bas.njk
permalink: /tjanster/index.html
sida: tjanster
sokvag: /tjanster/
---
{%- set s = sidor['tjanster'] -%}
<main id="innehall">
{% include "kort.njk" %}

<section aria-labelledby="h1" class="phero deco">
  <svg class="deco-svg deco-a link" width="760" height="520" viewBox="0 0 760 520" aria-hidden="true" focusable="false"><circle class="rl" cx="260" cy="260" r="250" fill="none" stroke="#7FD1C7" stroke-width="2" opacity=".35"></circle><circle class="rr" cx="500" cy="260" r="250" fill="none" stroke="#7FD1C7" stroke-width="2" opacity=".35"></circle></svg>
  <div class="wrap phero-txt">
    <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{{ s.topp.overrubrik | mdi | safe }}</p>
    <h1 id="h1">{{ s.topp.rubrik | mdi | safe }}</h1>
    <p class="lead">{{ s.topp.ingress | mdi | safe }}</p>
    <div class="btns">
      <a class="btn btn-cta btn-lg" href="/boka/">Boka tolk</a>
      <a class="btn btn-sec btn-lg" href="/kontakt/">Osäker? Fråga oss</a>
    </div>
    <nav aria-label="Tjänster på sidan">
      <ul class="toc">
        <li>{{ s.topp.punkt | mdi | safe }}</li>
        <li>{{ s.topp.punkt2 | mdi | safe }}</li>
        <li>{{ s.topp.punkt3 | mdi | safe }}</li>
        <li>{{ s.topp.punkt4 | mdi | safe }}</li>
      </ul>
    </nav>
  </div>
</section>

<section id="teckensprak" aria-labelledby="s1" class="svc-sec sec-white">
  <div class="wrap g svc-grid">
    <div class="svc-head">
      <svg width="72" height="56" viewBox="0 0 72 56" aria-hidden="true" focusable="false"><circle cx="27" cy="28" r="25" fill="none" stroke="#2BA89A" stroke-width="1.5"></circle><circle cx="45" cy="28" r="25" fill="none" stroke="#2BA89A" stroke-width="1.5" opacity=".5"></circle><svg x="25" y="17" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13V6.5a1.5 1.5 0 0 1 3 0V12"></path><path d="M11 11V5a1.5 1.5 0 0 1 3 0v6"></path><path d="M14 11V6.5a1.5 1.5 0 0 1 3 0V14a6 6 0 0 1-6 6h-.5a6 6 0 0 1-5-2.7L3.8 14.5a1.5 1.5 0 0 1 2.4-1.8L8 15"></path></svg></svg>
      <h2 id="s1">{{ s.s1.rubrik | mdi | safe }}</h2>
    </div>
    <div class="svc-main">
      <p>{{ s.s1.stycke | mdi | safe }}</p>
      <p>{{ s.s1.stycke2 | mdi | safe }}</p>
      <a class="btn btn-pet" href="/boka/">Boka teckenspråkstolk</a>
    </div>
    <div class="svc-side">
      <div><h3>{{ s.s1.block1.rubrik | mdi | safe }}</h3><ul class="bullets"><li>{{ s.s1.block1.punkt | mdi | safe }}</li><li>{{ s.s1.block1.punkt2 | mdi | safe }}</li><li>{{ s.s1.block1.punkt3 | mdi | safe }}</li><li>{{ s.s1.block1.punkt4 | mdi | safe }}</li></ul></div>
      <div><h3>{{ s.s1.block2.rubrik | mdi | safe }}</h3><p>{{ s.s1.block2.text | mdi | safe }}</p></div>
      <div><h3>{{ s.s1.block3.rubrik | mdi | safe }}</h3><ul class="bullets"><li>{{ s.s1.block3.punkt | mdi | safe }}</li><li>{{ s.s1.block3.punkt2 | mdi | safe }}</li><li>{{ s.s1.block3.punkt3 | mdi | safe }}</li><li>{{ s.s1.block3.punkt4 | mdi | safe }}</li></ul></div>
    </div>
  </div>
</section>

<section id="dovblind" aria-labelledby="s2" class="svc-sec sec-line">
  <div class="wrap g svc-grid">
    <div class="svc-head">
      <svg width="72" height="56" viewBox="0 0 72 56" aria-hidden="true" focusable="false"><circle cx="27" cy="28" r="25" fill="none" stroke="#2BA89A" stroke-width="1.5"></circle><circle cx="45" cy="28" r="25" fill="none" stroke="#2BA89A" stroke-width="1.5" opacity=".5"></circle><svg x="25" y="17" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14l4-4 3 2 3-3"></path><path d="M10 20l3-3 3 1 5-5"></path><circle cx="18" cy="5" r="1.2"></circle><circle cx="6" cy="19" r="1.2"></circle></svg></svg>
      <h2 id="s2">{{ s.s2.rubrik | mdi | safe }}</h2>
    </div>
    <div class="svc-main">
      <p>{{ s.s2.stycke | mdi | safe }}</p>
      <dl class="terms">
        <div><dt>{{ s.s2.rad1.rubrik | mdi | safe }}</dt><dd>{{ s.s2.rad1.text | mdi | safe }}</dd></div>
        <div><dt>{{ s.s2.rad2.rubrik | mdi | safe }}</dt><dd>{{ s.s2.rad2.text | mdi | safe }}</dd></div>
        <div><dt>{{ s.s2.rad3.rubrik | mdi | safe }}</dt><dd>{{ s.s2.rad3.text | mdi | safe }}</dd></div>
        <div><dt>{{ s.s2.rad4.rubrik | mdi | safe }}</dt><dd>{{ s.s2.rad4.text | mdi | safe }}</dd></div>
      </dl>
      <a class="btn btn-pet" href="/boka/">Boka dövblindtolk</a>
    </div>
    <div class="svc-side">
      <div><h3>{{ s.s2.block1.rubrik | mdi | safe }}</h3><ul class="bullets"><li>{{ s.s2.block1.punkt | mdi | safe }}</li><li>{{ s.s2.block1.punkt2 | mdi | safe }}</li><li>{{ s.s2.block1.punkt3 | mdi | safe }}</li></ul></div>
      <div><h3>{{ s.s2.block2.rubrik | mdi | safe }}</h3><p>{{ s.s2.block2.text | mdi | safe }}</p></div>
      <div><h3>{{ s.s2.block3.rubrik | mdi | safe }}</h3><ul class="bullets"><li>{{ s.s2.block3.punkt | mdi | safe }}</li><li>{{ s.s2.block3.punkt2 | mdi | safe }}</li><li>{{ s.s2.block3.punkt3 | mdi | safe }}</li><li>{{ s.s2.block3.punkt4 | mdi | safe }}</li></ul></div>
    </div>
  </div>
</section>

<section id="distans" aria-labelledby="s3" class="svc-sec sec-white">
  <div class="wrap g svc-grid">
    <div class="svc-head">
      <svg width="72" height="56" viewBox="0 0 72 56" aria-hidden="true" focusable="false"><circle cx="27" cy="28" r="25" fill="none" stroke="#2BA89A" stroke-width="1.5"></circle><circle cx="45" cy="28" r="25" fill="none" stroke="#2BA89A" stroke-width="1.5" opacity=".5"></circle><svg x="25" y="17" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0B3C49" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="1.5"></rect><path d="M8 20h8M12 16v4"></path><circle cx="12" cy="9" r="2"></circle><path d="M8.5 14a3.5 3.5 0 0 1 7 0"></path></svg></svg>
      <h2 id="s3">{{ s.s3.rubrik | mdi | safe }}</h2>
    </div>
    <div class="svc-main">
      <p>{{ s.s3.stycke | mdi | safe }}</p>
      <p>{{ s.s3.stycke2 | mdi | safe }}</p>
      <a class="btn btn-pet" href="/boka/">Boka distanstolk</a>
    </div>
    <div class="svc-side">
      <div><h3>{{ s.s3.block1.rubrik | mdi | safe }}</h3><ul class="bullets"><li>{{ s.s3.block1.punkt | mdi | safe }}</li><li>{{ s.s3.block1.punkt2 | mdi | safe }}</li><li>{{ s.s3.block1.punkt3 | mdi | safe }}</li><li>{{ s.s3.block1.punkt4 | mdi | safe }}</li></ul></div>
      <div><h3>{{ s.s3.block2.rubrik | mdi | safe }}</h3><p>{{ s.s3.block2.text | mdi | safe }}</p></div>
      <div><h3>{{ s.s3.block3.rubrik | mdi | safe }}</h3><ul class="bullets"><li>{{ s.s3.block3.punkt | mdi | safe }}</li><li>{{ s.s3.block3.punkt2 | mdi | safe }}</li><li>{{ s.s3.block3.punkt3 | mdi | safe }}</li><li>{{ s.s3.block3.punkt4 | mdi | safe }}</li></ul></div>
    </div>
  </div>
</section>

<section aria-labelledby="s-it" class="sec sec-panel" style="--sektion:72px">
  <div class="wrap stack">
    <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{{ s.s_it.overrubrik | mdi | safe }}</p>
    <div class="g soon" style="width:100%">
      <div class="stack" style="gap:12px">
        <h2 id="s-it" style="font-size:32px">Teknik och IT för tolkverksamhet <span class="pill" style="vertical-align:middle">Kommer snart</span></h2>
        <p class="muted">{{ s.s_it.stycke | mdi | safe }}</p>
      </div>
      <a href="/kontakt/" class="link-strong">Intresserad? Hör av dig <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<section id="fragor" aria-labelledby="s-faq" class="sec">
  <div class="wrap g faq-grid">
    <div class="sec-intro">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{{ s.s_faq.overrubrik | mdi | safe }}</p>
      <h2 id="s-faq">{{ s.s_faq.rubrik | mdi | safe }}</h2>
      <p class="muted">{{ s.s_faq.stycke | mdi | safe }}</p>
    </div>
    <div class="faq">
      <details open>
        <summary><span>{{ s.s_faq.fraga1.rubrik | mdi | safe }}</span><span class="ico" aria-hidden="true"></span></summary>
        <div class="faq-a"><p>{{ s.s_faq.fraga1.text | mdi | safe }}</p></div>
      </details>
      <details>
        <summary><span>{{ s.s_faq.fraga2.rubrik | mdi | safe }}</span><span class="ico" aria-hidden="true"></span></summary>
        <div class="faq-a"><p>{{ s.s_faq.fraga2.text | mdi | safe }}</p></div>
      </details>
      <details>
        <summary><span>{{ s.s_faq.fraga3.rubrik | mdi | safe }}</span><span class="ico" aria-hidden="true"></span></summary>
        <div class="faq-a"><p>{{ s.s_faq.fraga3.text | mdi | safe }}</p></div>
      </details>
      <details>
        <summary><span>{{ s.s_faq.fraga4.rubrik | mdi | safe }}</span><span class="ico" aria-hidden="true"></span></summary>
        <div class="faq-a"><p>{{ s.s_faq.fraga4.text | mdi | safe }}</p></div>
      </details>
      <details>
        <summary><span>{{ s.s_faq.fraga5.rubrik | mdi | safe }}</span><span class="ico" aria-hidden="true"></span></summary>
        <div class="faq-a"><p>{{ s.s_faq.fraga5.text | mdi | safe }}</p></div>
      </details>
      <details>
        <summary><span>{{ s.s_faq.fraga6.rubrik | mdi | safe }}</span><span class="ico" aria-hidden="true"></span></summary>
        <div class="faq-a"><p>{{ s.s_faq.fraga6.text | mdi | safe }}</p></div>
      </details>
    </div>
  </div>
</section>

<section aria-labelledby="s-cta" class="sec dark deco" style="--sektion:80px">
  <svg class="deco-svg deco-a link" width="640" height="440" viewBox="0 0 640 440" aria-hidden="true" focusable="false"><circle class="rl" cx="220" cy="220" r="210" fill="none" stroke="#7FD1C7" stroke-width="2" opacity=".45"></circle><circle class="rr" cx="420" cy="220" r="210" fill="none" stroke="#7FD1C7" stroke-width="2" opacity=".45"></circle></svg>
  <div class="wrap cta-box" style="background:none;border:0;padding:0">
    <div><h2 id="s-cta">{{ s.s_cta.rubrik | mdi | safe }}</h2><p class="lead" style="margin-top:8px">{{ s.s_cta.ingress | mdi | safe }}</p></div>
    <div class="btns"><a class="btn btn-cta btn-lg" href="/boka/">Boka tolk</a><a class="btn btn-sec btn-lg" href="/kontakt/">Kontakta oss</a></div>
  </div>
</section>
</main>
